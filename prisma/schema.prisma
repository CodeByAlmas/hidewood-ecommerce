datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS (Original + Role)
// ==========================================
enum Category {
  BELTS
  WALLETS
  BAGS
  ACCESSORIES
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum Role {
  PATRON
  ATELIER_ADMIN
}

// ==========================================
// 1. PATRON & IDENTITY (Added for Login/OAuth)
// ==========================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  passwordHash  String?   // For Master Key sign-in
  image         String?
  role          Role      @default(PATRON)
  
  // Archival Keycard Security
  patronPassKey String?   @unique // e.g. "HW-P2-8492"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reservations  Reservation[]

  @@index([email])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// 2. PRODUCTS & CATALOGUE (Your Existing Model 100% Intact)
// ==========================================
model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  price       Int              // Smallest currency unit (cents/paise)
  category    Category         @default(BELTS)
  leatherTone String           // 'Tuscan Tan', 'Obsidian Black', 'Oxblood'
  images      String[]
  inStock     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  orderItems  OrderItem[]
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size        String   // e.g., '32', '34', '36', '38', '40'
  width       String   // e.g., '32mm Dress', '38mm Casual Heritage'
  buckleType  String   // 'Antique Brass', 'Matte Gunmetal', 'Brushed Nickel'
  inventory   Int      @default(15)
}

// ==========================================
// 3. ORDERS (Your Existing Model + User Link)
// ==========================================
model Order {
  id             String      @id @default(cuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  customerEmail  String
  customerPhone  String?
  shippingAddr   Json
  totalAmount    Int
  currency       String      @default("INR")
  status         OrderStatus @default(PENDING)
  paymentId      String?     @unique
  paymentGateway String      // 'STRIPE' | 'RAZORPAY'
  items          OrderItem[]
  createdAt      DateTime    @default(now())

  @@index([customerEmail])
  @@index([userId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantInfo Json     // { size: '34', width: '38mm', buckle: 'Brass' }
  quantity    Int
  unitPrice   Int

  @@index([orderId])
  @@index([productId])
}

// ==========================================
// 4. CUSTOM INQUIRIES (Your Existing Model 100% Intact)
// ==========================================
model CustomInquiry {
  id        String   @id @default(cuid())
  services  String[]
  name      String
  email     String
  notes     String?
  createdAt DateTime @default(now())
}

// ==========================================
// 5. PHASE 02 DROP RESERVATION (Added for /reservation)
// ==========================================
model Reservation {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  patronName  String
  email       String
  phone       String
  passKey     String   @unique // e.g. "HW-P2-4910"
  silhouette  String   // e.g. "Tuscan Moto Rider"
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([passKey])
}